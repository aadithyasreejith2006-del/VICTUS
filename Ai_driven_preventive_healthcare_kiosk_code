  body('vitalSigns.oxygenSaturation')
    .optional()
    .isInt({ min: 70, max: 100 })
    .withMessage('Oxygen saturation must be between 70 and 100'),
  body('vitalSigns.weight')
    .optional()
    .isFloat({ min: 20, max: 500 })
    .withMessage('Weight must be between 20 and 500'),
  body('vitalSigns.height')
    .optional()
    .isFloat({ min: 100, max: 250 })
    .withMessage('Height must be between 100 and 250'),
  handleValidationErrors
];

