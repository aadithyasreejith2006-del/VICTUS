// @route   GET /api/kiosk/statistics
// @desc    Get kiosk statistics
// @access  Public
router.get('/statistics', async (req, res) => {
  try {
    const kioskId = req.query.kioskId || process.env.KIOSK_ID;
    const query = kioskId ? { kioskId } : {};

    // Get session statistics
    const totalSessions = await KioskSession.countDocuments(query);
    const completedSessions = await KioskSession.countDocuments({ 
      ...query, 
      status: 'completed' 
    });
    const activeSessions = await KioskSession.countDocuments({ 
      ...query, 
      status: 'active' 
    });

    // Get sessions by status
    const sessionsByStatus = await KioskSession.aggregate([
      { $match: query },
      {
        $group: {
          _id: '$status',
          count: { $sum: 1 }
        }
      }
    ]);

    // Get average session duration
    const avgDuration = await KioskSession.aggregate([
      { 
        $match: { 
          ...query, 
          status: 'completed',
          duration: { $exists: true }
        } 
      },
      {
        $group: {
          _id: null,
          avgDuration: { $avg: '$duration' }
        }
      }
    ]);

    // Get sessions by hour (last 24 hours)
    const last24Hours = new Date(Date.now() - 24 * 60 * 60 * 1000);
    const sessionsByHour = await KioskSession.aggregate([
      {
        $match: {
          ...query,
          startTime: { $gte: last24Hours }
        }
      },
      {
        $group: {
          _id: { $hour: '$startTime' },
          count: { $sum: 1 }
        }
      },
      { $sort: { '_id': 1 } }
    ]);

    res.json({
      success: true,
      data: {
        totalSessions,
        completedSessions,
        activeSessions,
        completionRate: totalSessions > 0 ? (completedSessions / totalSessions * 100).toFixed(2) : 0,
        sessionsByStatus,
        averageDuration: avgDuration[0]?.avgDuration || 0,
        sessionsByHour
      }
    });
  } catch (error) {
    console.error('Get kiosk statistics error:', error);
    res.status(500).json({
      success: false,
      message: 'Server error'
    });
  }
});

