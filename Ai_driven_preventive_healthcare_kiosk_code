const express = require('express');
const axios = require('axios');
const HealthAssessment = require('../models/HealthAssessment');
const { auth, optionalAuth } = require('../middleware/auth');

const router = express.Router();

// AI Analysis Service
class HealthAIAnalyzer {
  constructor() {
    this.apiKey = process.env.OPENAI_API_KEY;
    this.baseURL = 'https://api.openai.com/v1';
  }

  async analyzeHealthData(assessmentData) {
    try {
      // Prepare the health data for AI analysis
      const healthContext = this.prepareHealthContext(assessmentData);
      
      // Generate AI analysis using OpenAI
      const analysis = await this.generateHealthAnalysis(healthContext);
      
      // Process and structure the analysis
      return this.processAnalysis(analysis, assessmentData);
    } catch (error) {
      console.error('AI Analysis Error:', error);
      return this.getFallbackAnalysis(assessmentData);
    }
  }

  prepareHealthContext(assessmentData) {
    const { vitalSigns, symptoms, lifestyle, questionnaire } = assessmentData;
    
    let context = "Health Assessment Data:\n\n";
    
    // Vital Signs
    if (vitalSigns) {
      context += "Vital Signs:\n";
      if (vitalSigns.bloodPressure) {
        context += `- Blood Pressure: ${vitalSigns.bloodPressure.systolic}/${vitalSigns.bloodPressure.diastolic} mmHg\n`;
      }
      if (vitalSigns.heartRate) {
        context += `- Heart Rate: ${vitalSigns.heartRate} bpm\n`;
      }
      if (vitalSigns.temperature) {
        context += `- Temperature: ${vitalSigns.temperature}°F\n`;
      }
      if (vitalSigns.oxygenSaturation) {
        context += `- Oxygen Saturation: ${vitalSigns.oxygenSaturation}%\n`;
      }
      if (vitalSigns.weight && vitalSigns.height) {
        context += `- Weight: ${vitalSigns.weight} kg, Height: ${vitalSigns.height} cm\n`;
        if (vitalSigns.bmi) {
          context += `- BMI: ${vitalSigns.bmi}\n`;
        }
      }
      context += "\n";
    }

    // Symptoms
    if (symptoms && symptoms.primarySymptoms) {
      context += "Primary Symptoms:\n";
      symptoms.primarySymptoms.forEach(symptom => {
        context += `- ${symptom.symptom} (${symptom.severity}, ${symptom.duration})\n`;
      });
      context += "\n";
    }

    // Lifestyle
    if (lifestyle) {
      context += "Lifestyle Factors:\n";
      context += `- Exercise: ${lifestyle.exerciseFrequency}\n`;
      context += `- Diet: ${lifestyle.dietQuality}\n`;
      context += `- Sleep: ${lifestyle.sleepHours} hours\n`;
      context += `- Stress: ${lifestyle.stressLevel}\n`;
      context += `- Smoking: ${lifestyle.smokingStatus}\n`;
      context += `- Alcohol: ${lifestyle.alcoholConsumption}\n`;
      context += "\n";
    }

    return context;
  }

  async generateHealthAnalysis(healthContext) {
    if (!this.apiKey) {
      throw new Error('OpenAI API key not configured');
    }

    const prompt = `
As a medical AI assistant, analyze the following health assessment data and provide:

1. Risk Score (0-100): Overall health risk assessment
2. Risk Factors: List of identified risk factors
3. Recommendations: Specific, actionable health recommendations with priority levels
4. Predicted Conditions: Potential health conditions with probability estimates
5. Follow-up Requirements: Whether medical follow-up is needed and timeframe
6. Urgency Level: low, medium, high, or critical

Health Data:
${healthContext}

Please provide a structured analysis focusing on preventive healthcare and early intervention. Be specific and actionable in your recommendations.

Format your response as JSON with the following structure:
{
  "riskScore": number,
  "riskFactors": ["factor1", "factor2"],
  "recommendations": [
    {
      "category": "string",
      "priority": "low|medium|high|urgent",
      "title": "string",
      "description": "string",
      "actionItems": ["action1", "action2"]
    }
  ],
  "predictedConditions": [
    {
      "condition": "string",
      "probability": number,
      "confidence": "low|medium|high"
    }
  ],
  "followUpRequired": boolean,
  "followUpTimeframe": "string",
  "urgencyLevel": "low|medium|high|critical"
}
`;

    try {
      const response = await axios.post(
        `${this.baseURL}/chat/completions`,
        {
          model: "gpt-4",
          messages: [
            {
              role: "system",
              content: "You are a medical AI assistant specializing in preventive healthcare analysis. Provide accurate, evidence-based health assessments and recommendations. Always emphasize the importance of consulting healthcare professionals for medical decisions."
            },
            {
              role: "user",
              content: prompt
            }
          ],
          max_tokens: 2000,
          temperature: 0.3
        },
        {
          headers: {
            'Authorization': `Bearer ${this.apiKey}`,
            'Content-Type': 'application/json'
          }
        }
      );

      const content = response.data.choices[0].message.content;
      return JSON.parse(content);
    } catch (error) {
      console.error('OpenAI API Error:', error.response?.data || error.message);
      throw error;
    }
  }

  processAnalysis(analysis, assessmentData) {
    // Validate and clean the analysis data
    const processedAnalysis = {
      riskScore: Math.max(0, Math.min(100, analysis.riskScore || 0)),
      riskFactors: Array.isArray(analysis.riskFactors) ? analysis.riskFactors : [],
      recommendations: Array.isArray(analysis.recommendations) ? analysis.recommendations : [],
      predictedConditions: Array.isArray(analysis.predictedConditions) ? analysis.predictedConditions : [],
      followUpRequired: Boolean(analysis.followUpRequired),
      followUpTimeframe: analysis.followUpTimeframe || 'Not specified',
      urgencyLevel: ['low', 'medium', 'high', 'critical'].includes(analysis.urgencyLevel) 
        ? analysis.urgencyLevel 
        : 'low'
    };

    // Add additional context-based recommendations
    this.addContextualRecommendations(processedAnalysis, assessmentData);

    return processedAnalysis;
  }

  addContextualRecommendations(analysis, assessmentData) {
    const { vitalSigns, lifestyle } = assessmentData;

    // BMI-based recommendations
    if (vitalSigns?.bmi) {
      const bmi = parseFloat(vitalSigns.bmi);
      if (bmi < 18.5) {
        analysis.recommendations.push({
          category: 'Nutrition',
          priority: 'medium',
          title: 'Underweight - Nutritional Support',
          description: 'Your BMI indicates you may be underweight. Consider consulting a nutritionist.',
          actionItems: ['Consult with a nutritionist', 'Increase caloric intake with healthy foods', 'Monitor weight regularly']
        });
      } else if (bmi > 30) {
        analysis.recommendations.push({
          category: 'Weight Management',
          priority: 'high',
          title: 'Obesity - Weight Management',
          description: 'Your BMI indicates obesity. Weight management is important for overall health.',
          actionItems: ['Consult with a healthcare provider', 'Develop a weight loss plan', 'Increase physical activity', 'Modify diet']
        });
      }
    }

    // Blood pressure recommendations
    if (vitalSigns?.bloodPressure) {
      const { systolic, diastolic } = vitalSigns.bloodPressure;
      if (systolic >= 140 || diastolic >= 90) {
        analysis.recommendations.push({
          category: 'Cardiovascular',
          priority: 'urgent',
          title: 'High Blood Pressure',
          description: 'Your blood pressure readings are elevated. Immediate medical attention may be required.',
          actionItems: ['Consult a healthcare provider immediately', 'Monitor blood pressure regularly', 'Reduce sodium intake', 'Increase physical activity']
        });
        analysis.urgencyLevel = 'high';
      }
    }

    // Lifestyle recommendations
    if (lifestyle?.exerciseFrequency === 'none') {
      analysis.recommendations.push({
        category: 'Physical Activity',
        priority: 'medium',
        title: 'Increase Physical Activity',
        description: 'Regular exercise is important for overall health and disease prevention.',
        actionItems: ['Start with 10-15 minutes of daily walking', 'Gradually increase activity level', 'Find activities you enjoy']
      });
    }
  }

  getFallbackAnalysis(assessmentData) {
    // Fallback analysis when AI service is unavailable
    const { vitalSigns } = assessmentData;
    let riskScore = 30; // Default moderate risk
    let urgencyLevel = 'low';
    const recommendations = [];

    // Basic risk assessment based on vital signs
    if (vitalSigns?.bloodPressure) {
      const { systolic, diastolic } = vitalSigns.bloodPressure;
      if (systolic >= 140 || diastolic >= 90) {
        riskScore = 80;
        urgencyLevel = 'high';
        recommendations.push({
          category: 'Cardiovascular',
          priority: 'urgent',
          title: 'High Blood Pressure Detected',
          description: 'Your blood pressure readings are elevated. Please consult a healthcare provider.',
          actionItems: ['Consult healthcare provider', 'Monitor blood pressure', 'Reduce sodium intake']
        });
      }
    }

    if (vitalSigns?.bmi) {
      const bmi = parseFloat(vitalSigns.bmi);
      if (bmi > 30) {
        riskScore = Math.max(riskScore, 60);
        recommendations.push({
          category: 'Weight Management',
          priority: 'high',
          title: 'Weight Management Recommended',
          description: 'Your BMI indicates obesity. Weight management is important for health.',
          actionItems: ['Consult healthcare provider', 'Develop weight loss plan', 'Increase physical activity']
        });
      }
    }

    return {
      riskScore,
      riskFactors: ['Basic assessment completed - AI analysis unavailable'],
      recommendations,
      predictedConditions: [],
      followUpRequired: urgencyLevel === 'high',
      followUpTimeframe: urgencyLevel === 'high' ? 'Within 1 week' : 'Within 1 month',
      urgencyLevel
    };
  }
}

const aiAnalyzer = new HealthAIAnalyzer();

// @route   POST /api/ai/analyze
// @desc    Analyze health assessment data using AI
// @access  Private
router.post('/analyze', auth, async (req, res) => {
  try {
    const { assessmentId } = req.body;

    if (!assessmentId) {
      return res.status(400).json({
        success: false,
        message: 'Assessment ID is required'
      });
    }

    // Get the health assessment
    const assessment = await HealthAssessment.findOne({
      _id: assessmentId,
      userId: req.user._id
    });

    if (!assessment) {
      return res.status(404).json({
        success: false,
        message: 'Health assessment not found'
      });
    }

    // Perform AI analysis
    const aiAnalysis = await aiAnalyzer.analyzeHealthData(assessment);

    // Update the assessment with AI analysis
    assessment.aiAnalysis = aiAnalysis;
    assessment.status = 'completed';
    assessment.completedAt = new Date();
    await assessment.save();

    res.json({
      success: true,
      message: 'Health assessment analyzed successfully',
      data: {
        assessment,
        aiAnalysis
      }
    });
  } catch (error) {
    console.error('AI Analysis error:', error);
    res.status(500).json({
      success: false,
      message: 'Error during AI analysis'
    });
  }
});

